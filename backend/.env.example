PORT=3000
APP_URL=http://localhost:4200

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=app_calculos
DB_PASSWORD=app_calculos
DB_DATABASE=app_calculos

# development | production
NODE_ENV=development

# Intentos gratuitos por dispositivo (default: 3)
FREE_ATTEMPTS=3

# --- Stripe Billing (https://dashboard.stripe.com) ---
# Crear producto + 3 precios recurrentes (mensual/semestral/anual) y copiar sus price_xxx
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_MONTHLY=price_...
STRIPE_PRICE_ID_SEMIANNUAL=price_...
STRIPE_PRICE_ID_ANNUAL=price_...

# --- PayPal Subscriptions (https://developer.paypal.com) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Crear producto + 3 planes (mensual/semestral/anual) y copiar sus plan_id
PAYPAL_PLAN_ID_MONTHLY=P-...
PAYPAL_PLAN_ID_SEMIANNUAL=P-...
PAYPAL_PLAN_ID_ANNUAL=P-...
PAYPAL_WEBHOOK_ID=
# Sandbox: https://api-m.sandbox.paypal.com | Live: https://api-m.paypal.com
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
