PORT=3000
APP_URL=http://localhost:4200

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=app_calculos
DB_PASSWORD=app_calculos
DB_DATABASE=app_calculos

# development | production
NODE_ENV=development

# Intentos gratuitos por dispositivo (default: 3)
FREE_ATTEMPTS=3

# --- Auth (cuentas) ---
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=30d
# Google Cloud Console -> OAuth Client ID (tipo Web)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Minutos de validez del link de "olvide mi contrasena" (default: 60)
PASSWORD_RESET_EXPIRES_MINUTES=60
# SMTP para el correo de recuperacion de contrasena. Si se deja vacio, el
# link se loguea en la consola del backend (util para desarrollo local).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ÖstiTax <no-reply@ostitax.at>

# --- FinanzOnline (envio directo de declaraciones al BMF) ---
# NO es autoservicio como Stripe/PayPal: requiere certificacion oficial
# del Bundesministerium fuer Finanzen como transmisor de datos autorizado.
# Ver README para el proceso. Mientras FINANZONLINE_ENABLED=false, la app
# sigue generando el PDF para cargar manualmente en FinanzOnline.
FINANZONLINE_ENABLED=false
FINANZONLINE_WEBSERVICE_URL=
FINANZONLINE_TEILNEHMER_ID=
FINANZONLINE_BENUTZER_ID=
FINANZONLINE_PIN=

# --- GoCardless Bank Account Data (https://bankaccountdata.gocardless.com) ---
# A diferencia de FinanzOnline, esto SI es autoservicio: registrarse gratis
# y crear un "user secret" (secret_id + secret_key) en el dashboard.
GOCARDLESS_ENABLED=false
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=
GOCARDLESS_BASE_URL=https://bankaccountdata.gocardless.com/api/v2

# --- Stripe Billing (https://dashboard.stripe.com) ---
# Crear producto + 4 precios recurrentes (individual/empresa x mensual/anual) y copiar sus price_xxx
# Individual (empleados/estudiantes): 3,99 EUR/mes o 39,99 EUR/ano
# Empresa: 12,99 EUR/mes o 129,99 EUR/ano
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_INDIVIDUAL_MONTHLY=price_...
STRIPE_PRICE_ID_INDIVIDUAL_ANNUAL=price_...
STRIPE_PRICE_ID_COMPANY_MONTHLY=price_...
STRIPE_PRICE_ID_COMPANY_ANNUAL=price_...

# --- PayPal Subscriptions (https://developer.paypal.com) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Crear producto + 4 planes (individual/empresa x mensual/anual) y copiar sus plan_id
PAYPAL_PLAN_ID_INDIVIDUAL_MONTHLY=P-...
PAYPAL_PLAN_ID_INDIVIDUAL_ANNUAL=P-...
PAYPAL_PLAN_ID_COMPANY_MONTHLY=P-...
PAYPAL_PLAN_ID_COMPANY_ANNUAL=P-...
PAYPAL_WEBHOOK_ID=
# Sandbox: https://api-m.sandbox.paypal.com | Live: https://api-m.paypal.com
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
